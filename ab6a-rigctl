MENU = """
  {s} start    {k} stop     {r} restart   {t} test    {g} log
  {n} new      {e} edit     {x} delete
  {a} start all connected   {K} stop all
  {m} shared memory limits (sysctl)
  {v} show all serial devices (not just usbmodem)
  {l} rescan   {q} quit
"""


def flat_profiles(cfg):
    """Profiles in the order the menu numbers them (grouped by radio)."""
    out = []
    for _, profiles in radios_in_config(cfg):
        out.extend(profiles)
    return out


def resolve_many(cfg, arg):
    """Map '2', a daemon name, or a radio name to one or more daemons.

    Naming a radio selects every daemon on it, which is usually what you want
    when a radio drives several interfaces.
    """
    if not arg:
        return []
    flat = flat_profiles(cfg)

    if arg.isdigit():
        idx = int(arg)
        return [flat[idx - 1]] if 1 <= idx <= len(flat) else []

    needle = arg.lower().strip()

    # a whole radio
    for radio_name, profiles in radios_in_config(cfg):
        if radio_name.lower() == needle:
            return list(profiles)

    # one daemon, by id or exact name
    for p in flat:
        if p["id"] == needle or p["name"].lower() == needle \
                or full_name(p).lower() == needle:
            return [p]

    # substring, daemons first then radios
    hits = [p for p in flat if needle in full_name(p).lower()]
    if hits:
        return hits
    for radio_name, profiles in radios_in_config(cfg):
        if needle in radio_name.lower():
            return list(profiles)
    return []


def resolve(cfg, arg):
    hits = resolve_many(cfg, arg)
    return hits[0] if len(hits) == 1 else None


def need_targets(cfg, arg, devices):
    """One or more daemons for a command that can act on a whole radio."""
    if not cfg["profiles"]:
        print(yellow("  no radios configured yet"))
        print(dim("  press 'n' to add one"))
        return []

    hits = resolve_many(cfg, arg)
    if hits:
        return hits

    typed = arg
    if not arg:
        typed = ask("  which radio or daemon?")
        hits = resolve_many(cfg, typed)
        if hits:
            return hits

    if not typed:
        return []

    # the connected-radio list carries no handles, but people reasonably try
    if re.fullmatch(r"d\d+", typed.strip(), re.I):
        print(red("  %s is not a name" % typed))
        print(dim("  that list is attached radios with no daemon yet - press 'n'"))
        print(dim("  to configure one. This command takes a radio or daemon name."))
        return []

    print(red("  no such radio or daemon: %s" % typed))
    print(dim("  known: %s" % ", ".join(full_name(x) for x in flat_profiles(cfg))))
    return []


def need_one(cfg, arg, devices):
    """Exactly one daemon, for commands that cannot act on a whole radio."""
    hits = need_targets(cfg, arg, devices)
    if len(hits) == 1:
        return hits[0]
    if not hits:
        return None
    print(yellow("  that matches %d daemons:" % len(hits)))
    flat = flat_profiles(cfg)
    for p in hits:
        print("   %s  %s" % (cyan("%2d" % (flat.index(p) + 1)), full_name(p)))
    return resolve(cfg, ask("  which number?"))


def rig_query(port, commands, timeout=4.0):
    """Speak the rigctld network protocol directly.

    Cheaper than shelling out to rigctl, works whether or not rigctl is on
    PATH, and - unlike rigctl - it cannot block forever on a wedged daemon.
    """
    replies = []
    with socket.create_connection(("127.0.0.1", port), timeout=timeout) as s:
        s.settimeout(timeout)
        for cmd in commands:
            s.sendall((cmd + "\n").encode())
            buf = b""
            while b"\n" not in buf:
                chunk = s.recv(256)
                if not chunk:
                    break
                buf += chunk
            replies.append(buf.decode(errors="replace").strip())
    return replies


def test_profile(profile):
    """Ask the running daemon for frequency and mode."""
    pid = running_pid(profile)
    if not pid:
        print(red("  %s is not running" % full_name(profile)))
        return
    try:
        freq, mode = rig_query(profile["port"], ["f", "m"])
    except (OSError, socket.timeout) as exc:
        print(red("  could not reach the daemon on port %d: %s"
                  % (profile["port"], type(exc).__name__)))
        print(dim("  %s" % log_file(profile)))
        return

    # hamlib reports failures as "RPRT <negative errno>"
    for reply in (freq, mode):
        if reply.startswith("RPRT ") and reply.split()[-1] not in ("0", ""):
            print(red("  %s: rig returned %s" % (full_name(profile), reply)))
            print(dim("  the radio may be off, or another program may hold the port"))
            return

    try:
        shown = "{:,}".format(int(freq.splitlines()[0])) + " Hz"
    except (ValueError, IndexError):
        shown = freq or "(no reply)"
    mode_txt = " ".join(mode.split()) if mode else ""
    print(green("  %s: " % full_name(profile)) + shown
          + (dim("   mode %s" % mode_txt) if mode_txt else ""))


def interactive():
    cfg = load_config()
    while True:
        devices = discover_devices()
        os.system("clear") if USE_COLOR else None
        print(bold("  AB6A RigCtl") + dim("  -  rigctld manager"))
        print_profiles(cfg, devices)
        print_devices(cfg, devices)
        print(MENU.format(s=cyan("s"), k=cyan("k"), r=cyan("r"), t=cyan("t"),
                          g=cyan("g"), n=cyan("n"), e=cyan("e"), x=cyan("x"),
                          a=cyan("a"), K=cyan("K"), m=cyan("m"), v=cyan("v"),
                          l=cyan("l"), q=cyan("q")))
        try:
            raw = input("  > ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        if not raw:
            continue

        cmd, _, arg = raw.partition(" ")
        arg = arg.strip()
        print()

        try:
            if cmd in ("q", "quit", "exit"):
                return 0
            elif cmd in ("l", "rescan"):
                cfg = load_config()
                continue
            elif cmd == "n":
                new_profile(cfg, devices)
            elif cmd == "a":
                start_all(cfg, devices)
            elif cmd == "K":
                stop_all(cfg)
            elif cmd == "m":
                shm_menu(cfg)
            elif cmd == "v":
                global SHOW_ALL_DEVICES
                SHOW_ALL_DEVICES = not SHOW_ALL_DEVICES
                continue
            elif cmd in ("s", "k", "r", "t"):
                # naming a radio acts on every daemon it runs
                for p in need_targets(cfg, arg, devices):
                    if cmd == "s":
                        start_profile(p, devices, cfg)
                    elif cmd == "k":
                        stop_profile(p)
                    elif cmd == "r":
                        stop_profile(p, quiet=True)
                        start_profile(p, devices, cfg)
                    elif cmd == "t":
                        test_profile(p)
            elif cmd in ("e", "x", "g"):
                p = need_one(cfg, arg, devices)
                if not p:
                    pass
                elif cmd == "e":
                    edit_profile(cfg, p, devices)
                elif cmd == "x":
                    delete_profile(cfg, p)
                elif cmd == "g":
                    print(dim("  %s" % log_file(p)))
                    tail_log(log_file(p), 20)
            else:
                print(red("  unknown command %r" % cmd))
        except (EOFError, KeyboardInterrupt):
            print(dim("\n  cancelled"))

        try:
            input(dim("\n  press return "))
        except (EOFError, KeyboardInterrupt):
            print()
            return 0


