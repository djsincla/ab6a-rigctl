def device_users(cfg, dev, devices, exclude_id=None):
    """Names of profiles already bound to this exact serial device."""
    names = []
    for p in cfg["profiles"]:
        if p["id"] == exclude_id:
            continue
        d = match_device(p.get("device"), devices)
        if d and d["dev"] == dev["dev"]:
            names.append(p["name"])
    return names


def confirm_device(cfg, dev, devices, exclude_id=None):
    """A serial interface belongs to exactly one daemon. False if it is taken."""
    clash = device_users(cfg, dev, devices, exclude_id)
    if not clash:
        return True
    print(red("\n  %s is already used by: %s" % (dev["dev"], ", ".join(clash))))
    print(dim("  a serial interface cannot be shared - one daemon per interface."))
    print(dim("  Bind to another interface on this radio, or delete that profile."))
    return False


def taken_devices(cfg, devices, exclude_id=None):
    """Map of /dev path -> profile name for interfaces already claimed."""
    taken = {}
    for p in cfg["profiles"]:
        if p["id"] == exclude_id:
            continue
        d = match_device(p.get("device"), devices)
        if d:
            taken[d["dev"]] = p["name"]
    return taken


def choose_radio(cfg, radios, devices):
    """Pick a physical radio, showing how many of its interfaces are free."""
    if not radios:
        print(red("  no radios attached"))
        return None
    taken = taken_devices(cfg, devices)
    print()
    for i, g in enumerate(radios, 1):
        free = [d for d in g["interfaces"] if d["dev"] not in taken]
        detail = "%d interface%s" % (len(g["interfaces"]),
                                     "" if len(g["interfaces"]) == 1 else "s")
        if not free:
            detail += ", all in use"
        elif len(free) != len(g["interfaces"]):
            detail += ", %d free" % len(free)
        tag = dim("  serial %s" % g["serial"]) if g.get("serial") else ""
        print("   %s  %-34s %s%s" % (cyan("%2d" % i), g["name"][:34],
                                     dim(detail), tag))
    while True:
        val = ask("\n  radio number (blank to cancel)")
        if not val:
            return None
        try:
            idx = int(val)
            if 1 <= idx <= len(radios):
                return radios[idx - 1]
        except ValueError:
            pass
        print(red("  pick 1-%d" % len(radios)))


def choose_interfaces(free):
    """Pick which of a radio's interfaces get a daemon."""
    if len(free) == 1:
        return list(free)
    print(bold("\n  Interfaces on this radio"))
    for i, d in enumerate(free, 1):
        print("   %s  %-16s %s" % (cyan("%2d" % i), interface_label(d), d["dev"]))
    print(dim("   each gets its own daemon on its own port"))
    while True:
        val = ask("\n  which? (e.g. 1, or 1,2, or 'all')", "all").strip().lower()
        if val in ("all", "*"):
            return list(free)
        picks, ok = [], True
        for part in val.replace(" ", "").split(","):
            if not part.isdigit() or not (1 <= int(part) <= len(free)):
                ok = False
                break
            if free[int(part) - 1] not in picks:
                picks.append(free[int(part) - 1])
        if ok and picks:
            return picks
        print(red("  pick 1-%d, comma separated, or 'all'" % len(free)))


def new_profile(cfg, devices):
    radios = group_devices(devices)
    g = choose_radio(cfg, radios, devices)
    if not g:
        return

    taken = taken_devices(cfg, devices)
    free = [d for d in g["interfaces"] if d["dev"] not in taken]
    if not free:
        print(red("\n  every interface on %s already has a daemon" % g["name"]))
        print(dim("  an interface cannot be shared - delete a profile to free one"))
        return

    # a radio already known to us keeps its name and model
    existing = [pr for pr in cfg["profiles"] if profile_radio_key(pr) == g["key"]]
    if existing:
        radio_name = profile_radio_name(existing[0])
        model = existing[0]["model"]
        baud = existing[0].get("baud")
        civ = existing[0].get("civaddr")
        print(dim("\n  adding to %s (%s)" % (radio_name, model_name(model))))
    else:
        radio_name = ask("\n  radio name", g["name"])
        model = choose_model(g["interfaces"][0])
        baud = ask_baud()
        civ = ask("  CI-V address (Icom only, blank for none)", "") or None

    picks = choose_interfaces(free)
    added = []
    for d in picks:
        print(bold("\n  %s  (%s)" % (interface_label(d), d["dev"])))
        default_label = "interface %s" % d["interface"] if d.get("interface") is not None \
            else "main"
        if len(picks) == 1 and not existing:
            default_label = "main"
        label = ask("  what will use it?", default_label)
        port = ask_port(cfg)

        fp = fingerprint(d)
        fp["dev"] = d["dev"]
        profile = {
            "id": unique_id(cfg, slugify("%s-%s" % (radio_name, label))),
            "name": label,
            "radio": {"key": g["key"], "name": radio_name, "serial": g.get("serial")},
            "model": model,
            "baud": baud,
            "port": port,
            "civaddr": civ or None,
            "extra_args": [],
            "device": fp,
        }
        cfg["profiles"].append(profile)
        added.append(profile)
        save_config(cfg)
        print(dim("  " + " ".join(build_command(profile, d["dev"]))))

    print(green("\n  saved ") + bold("%s" % radio_name)
          + dim("  (%d daemon%s)" % (len(added), "" if len(added) == 1 else "s")))

    if ask_yes("\n  start %s now?" % ("it" if len(added) == 1 else "them"), True):
        for profile in added:
            start_profile(profile, devices, cfg)


def edit_profile(cfg, profile, devices):
    print(bold("\n  editing %s" % profile["name"]))
    profile["name"] = ask("  name", profile["name"])

    dev = match_device(profile.get("device"), devices)
    if dev:
        print(dim("  device: %s (%s)" % (device_label(dev), dev["dev"])))
        if ask_yes("  bind to a different device?", False):
            nd = choose_device(devices, taken_devices(cfg, devices, profile["id"]))
            if nd and not confirm_device(cfg, nd, devices, profile["id"]):
                nd = None
            if nd:
                fp = fingerprint(nd)
                fp["dev"] = nd["dev"]
                profile["device"] = fp
                dev = nd
    else:
        print(yellow("  saved device is not connected"))
        if ask_yes("  bind to a connected device now?", True):
            nd = choose_device(devices, taken_devices(cfg, devices, profile["id"]))
            if nd and not confirm_device(cfg, nd, devices, profile["id"]):
                nd = None
            if nd:
                fp = fingerprint(nd)
                fp["dev"] = nd["dev"]
                profile["device"] = fp
                dev = nd

    print(dim("  model: %s" % model_name(profile["model"])))
    if ask_yes("  change model?", False):
        profile["model"] = choose_model(dev, profile["model"])

    profile["baud"] = ask_baud(profile.get("baud"))
    profile["port"] = ask_port(cfg, profile["port"], profile["id"])
    civ = ask("  CI-V address (blank for none)", profile.get("civaddr") or "")
    profile["civaddr"] = civ or None
    extra = ask("  extra rigctld arguments",
                " ".join(profile.get("extra_args") or []))
    profile["extra_args"] = extra.split() if extra else []

    save_config(cfg)
    print(green("  saved"))
    if running_pid(profile) and ask_yes("  restart with the new settings?", True):
        stop_profile(profile, quiet=True)
        start_profile(profile, devices, cfg)


def delete_profile(cfg, profile):
    if not ask_yes("  delete %r?" % profile["name"], False):
        return
    stop_profile(profile, quiet=True)
    cfg["profiles"] = [p for p in cfg["profiles"] if p["id"] != profile["id"]]
    save_config(cfg)
    for path in (pid_file(profile), log_file(profile)):
        try:
            os.unlink(path)
        except OSError:
            pass
    print(green("  deleted"))


def start_all(cfg, devices):
    any_started = False
    for p in cfg["profiles"]:
        if match_device(p.get("device"), devices) and not running_pid(p):
            start_profile(p, devices, cfg)
            any_started = True
    if not any_started:
        print(dim("  nothing to start - every connected radio is already running"))


def stop_all(cfg):
    stopped = False
    for p in cfg["profiles"]:
        if running_pid(p):
            stop_profile(p)
            stopped = True
    if not stopped:
        print(dim("  nothing running"))


