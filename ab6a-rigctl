USAGE = """usage: ab6a-rigctl [command]

  (no command)     interactive manager
  devices [--all]  list attached radios (--all: every serial device)
  list | status    list saved radios and whether they are running
  start [name|all] start daemons - a radio name starts every daemon on it
  stop  [name|all] stop daemons (default: all)
  restart [name]   stop then start
  models [search]  list Hamlib rig models
  shm [--apply] [--persist]
                   show/raise the SysV shared memory limits some ham
                   software needs (--persist writes /etc/sysctl.conf)
"""


def main(argv):
    if not shutil.which("rigctld"):
        die("rigctld not found on PATH - install it with: brew install hamlib")

    if not argv:
        if not sys.stdin.isatty():
            print(USAGE, file=sys.stderr)
            return 2
        return interactive()

    cmd, args = argv[0], argv[1:]
    cfg = load_config()

    if cmd in ("-h", "--help", "help"):
        print(USAGE)
        return 0

    if cmd == "devices":
        if "--all" in args or "-a" in args:
            globals()["SHOW_ALL_DEVICES"] = True
        devices = discover_devices()
        if not devices:
            print("no serial devices attached")
            return 0
        for d in devices:
            print("%-46s %s%s" % (device_label(d)[:46], d["dev"],
                                  "  serial %s" % d["serial"] if d.get("serial") else ""))
        return 0

    if cmd in ("shm", "sysctl"):
        if "--apply" in args:
            shm_report(cfg)
            shm_apply(cfg)
            if "--persist" in args:
                shm_persist(cfg)
        elif "--persist" in args:
            shm_report(cfg)
            shm_persist(cfg)
        else:
            pending = shm_report(cfg)
            if pending:
                print(dim("\n  run: ab6a-rigctl shm --apply [--persist]"))
        return 0

    if cmd == "models":
        needle = _norm(args[0]) if args else ""
        for m in rig_models():
            if needle and needle not in _norm(m["mfg"] + m["model"]):
                continue
            print("%-6d %-12s %-24s %s" % (m["id"], m["mfg"], m["model"], m["status"]))
        return 0

    if cmd in ("list", "status", "ls"):
        devices = discover_devices()
        if not cfg["profiles"]:
            print("no saved radios - run ab6a-rigctl with no arguments to add one")
            return 0
        for radio_name, profiles in radios_in_config(cfg):
            print("%s  %s" % (bold(radio_name), dim(model_name(profiles[0]["model"]))))
            for p in profiles:
                state, pid, dev = profile_status(p, devices)
                print("  %-18s port %-6d %-26s %s%s" % (
                    p["name"][:18], p["port"],
                    dev["dev"] if dev else "not connected",
                    state, "  pid %d" % pid if pid else ""))
        return 0

    if cmd in ("start", "stop", "restart"):
        devices = discover_devices()
        target = args[0] if args else "all"

        if target == "all":
            targets = flat_profiles(cfg)
        else:
            # a radio name covers every daemon on that radio
            targets = resolve_many(cfg, target)
            if not targets:
                die("no such radio or daemon: %s" % target)

        if cmd in ("stop", "restart"):
            for p in targets:
                stop_profile(p, quiet=(target == "all"))
        if cmd in ("start", "restart"):
            for p in targets:
                if target == "all" and not match_device(p.get("device"), devices):
                    continue
                start_profile(p, devices, cfg)
        return 0

    print(USAGE, file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print()
        sys.exit(130)
